
# ==========================================
# PostgreSQL Learning - .gitignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets.json
credentials.json

# PostgreSQL database files
PG_VERSION
postmaster.pid
postmaster.opts
postgresql.auto.conf
pg_wal/
pg_xact/
pg_stat_tmp/
base/
global/
pg_tblspc/
pg_multixact/

# Database backups and dumps
*.backup
*.dump
*.bak
*.sql.gz
*.sql.zip
*.tar.gz
backups/
dumps/

# Temporary SQL files
*.sql~
*.sql.bak
*.tmp
*.temp
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# JetBrains IDEs
.idea/
*.iml

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*

# Node.js (if used for PostgreSQL projects)
node_modules/
dist/
build/
coverage/

# Temporary and cache directories
tmp/
temp/
.cache/
*.cache

# Local database storage
postgres-data/
postgres_data/
pgdata/
data/postgres/

# Docker overrides (local only)
docker-compose.override.yml
compose.override.yaml
